# Frontend (optional — defaults to /api/waitlist via Vite proxy in dev)
# VITE_WAITLIST_URL=https://api.kalpanik.in/api/waitlist

# API server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=kalpanik
DB_PASSWORD=your_db_password
DB_NAME=kalpanik

# SMTP (use your existing mail provider credentials)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@kalpanik.in
SMTP_PASS=your_smtp_password
SMTP_FROM=support@kalpanik.in
MAIL_FROM_NAME=Kalpanik
MAIL_REPLY_TO=support@kalpanik.in
# Email that receives a notification when someone joins the waitlist
ADMIN_NOTIFY_EMAIL=support@kalpanik.in

# Founder dashboard login (server-side only — never expose in frontend)
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_secure_password
JWT_SECRET=generate_a_long_random_secret_here
JWT_EXPIRES_IN=24h

# UPI (dynamic QR — no payment gateway SDK)
# Use your real UPI VPA (e.g. from PhonePe/GPay/HDFC)
KALPANIK_UPI_ID=yourupi@upi
KALPANIK_UPI_NAME=SHREE S2N SOLUTIONS
KALPANIK_ACTIVATION_SECRET=shared_secret_with_task_manager

# Invoice / legal + bank details printed on bills
KALPANIK_LEGAL_NAME=SHREE S2N SOLUTIONS
KALPANIK_BRAND_NAME=Kalpanik
KALPANIK_ADDRESS=ANANDAM WORLD CITY
KALPANIK_GSTIN=
KALPANIK_INVOICE_EMAIL=support@kalpanik.in
KALPANIK_INVOICE_PHONE=
KALPANIK_BANK_NAME=HDFC Bank
KALPANIK_BANK_BRANCH=ANANDAM WORLD CITY
KALPANIK_ACCOUNT_NAME=SHREE S2N SOLUTIONS
KALPANIK_ACCOUNT_NUMBER=50200121673990
KALPANIK_ACCOUNT_TYPE=Current Account
KALPANIK_IFSC=HDFC0006825
